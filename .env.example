# 로컬 설정. 복사해서 쓴다:  cp .env.example .env
# 없으면 아래 기본값으로 동작한다. docker compose와 Makefile이 이 파일을 읽는다.

# SIP 헤더와 SDP(c= 라인)에 '바깥에서 보이는 주소'로 적을 IP
#   Mac 안의 소프트폰만 쓸 때: 127.0.0.1 (기본)
#   같은 Wi-Fi의 휴대폰도 쓸 때: Mac의 LAN IP (make up-lan이 자동으로 넣어 준다)
EXTERNAL_IP=127.0.0.1

# SIP/RTP 포트를 어느 주소에 열지. 0.0.0.0이면 LAN 전체에 열린다 (카페 같은 공용 Wi-Fi에서는 주의)
PUBLISH_IP=127.0.0.1

# 로그 시간대
TZ=Asia/Seoul

# Asterisk 버전 (바꾸면 이미지를 다시 빌드한다)
ASTERISK_VERSION=22.11.0

# amicli 접속 정보 (asterisk/conf/manager.conf와 같아야 한다). make로 실행할 때 전달된다.
AMI_ADDR=127.0.0.1:5038
AMI_USER=ipcc
AMI_SECRET=ipcc-secret
